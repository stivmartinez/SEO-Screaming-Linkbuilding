# Copy to backend/.env or export in your shell. All keys use the CRAWLER_ prefix.

# SQLite database URL (default: backend/data/crawler.db)
# CRAWLER_DATABASE_URL=sqlite+aiosqlite:///./data/crawler.db

# Crawl identity
# CRAWLER_USER_AGENT=SEOScreamingLinkBuilding/1.0 (+https://stivmartinez.com; first-party SEO analysis)

# HTTP client
# CRAWLER_REQUEST_TIMEOUT=15.0
# CRAWLER_MAX_RESPONSE_BYTES=5000000

# Default crawl settings (overridable per crawl in the UI)
# CRAWLER_DEFAULT_CONCURRENCY=4
# CRAWLER_DEFAULT_DELAY_SECONDS=0.25
# CRAWLER_DEFAULT_MAX_PAGES=10000

# Comma-separated browser origins allowed to call the API (dev UI uses Vite on :5173)
# CRAWLER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides (desktop app sets these automatically)
# CRAWLER_DATA_DIR=/path/to/data
# CRAWLER_STATIC_DIR=/path/to/frontend/dist
